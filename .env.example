APP_LOCALE=ja
#APP_LOCALE=en
DISCORD_TOKEN=your_discord_bot_token
ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789
ALLOWED_USER_IDS=
SQLITE_PATH=./data/app.db
DEFAULT_AGENT_WORKDIR_ROOT=./workspaces
LOG_LEVEL=info

# English: Codex mode: cli or template.
# English: Use cli in normal operation. It saves thread_id via codex exec --json and resumes next time.
# Japanese: Codexモード: cli または template。
# Japanese: 通常運用は cli を使います。codex exec --json で thread_id を保存し、次回再開します。
CODEX_MODE=cli
INSTANCE_LOCK_PORT=45991
EXTERNAL_SYNC_ENABLED=true
EXTERNAL_SYNC_POLL_SEC=15
EXTERNAL_SYNC_MAX_BURST=30
EXTERNAL_SYNC_USER_MAX_CHARS=300
SHOW_FINAL_STREAM_LOG=true
FORCE_LEGACY_FULL_ACCESS=false

# English: Command template used only when CODEX_MODE=template.
# Japanese: CODEX_MODE=template のときだけ使うコマンドテンプレートです。
# English: {input} and {sessionId} are replaced before execution.
# Japanese: 実行前に {input} と {sessionId} が置換されます。
# Example: codex --session {sessionId} "{input}"
CODEX_EXEC_TEMPLATE=echo [MOCK CODEX][{sessionId}] {input}
CODEX_TIMEOUT_SEC=1800
CODEX_CLOSE_GRACE_SEC=10

# English: Incoming attachment handling.
# Japanese: 受信添付ファイル設定。
INCOMING_ATTACH_DIR=./data/incoming_attachments
INCOMING_ATTACH_TTL_HOURS=72
INCOMING_ATTACH_MAX_BYTES=20971520
