DISCORD_TOKEN=your_discord_bot_token
ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789
SQLITE_PATH=./data/app.db
LOG_LEVEL=info

# Codex実行モード: cli / template
# cli を推奨。codex exec --json を使って thread_id を保存し、次回 resume します。
CODEX_MODE=cli
INSTANCE_LOCK_PORT=45991

# template モード時の実行テンプレート:
# {input} と {sessionId} を置換して実行します。
# 例: codex --session {sessionId} "{input}"
CODEX_EXEC_TEMPLATE=echo [MOCK CODEX][{sessionId}] {input}
CODEX_TIMEOUT_SEC=1800
